---
// CpuCard.astro — Real CPU metrics + sparkline history chart
---

<div class="ios-glass p-4 rounded-[24px] flex flex-col justify-between aspect-square w-full relative overflow-hidden transition-all active:scale-98">
  <!-- Widget Top -->
  <div class="flex justify-between items-start w-full">
    <div class="w-9 h-9 rounded-full bg-[#00d4ff]/10 flex items-center justify-center text-[#00d4ff]">
      <span class="material-symbols-outlined text-lg">memory</span>
    </div>
    <span class="font-mono text-[10px] uppercase font-bold tracking-wider opacity-70" style="color:var(--pb-text-sub)">CPU</span>
  </div>

  <!-- Main Metric -->
  <div class="my-2 flex flex-col items-start gap-1">
    <span id="cpu-percent-text" class="font-mono text-3xl font-extrabold text-[#00d4ff] tracking-tight glow-cyan">--%</span>
    <div class="w-full bg-black/20 h-[4px] rounded-full overflow-hidden">
      <div id="cpu-progress-bar" class="bg-[#00d4ff] h-full progress-bar-anim rounded-full" style="width:0%"></div>
    </div>
  </div>

  <!-- Sparkline -->
  <canvas id="cpu-sparkline" height="36" class="w-full rounded-[6px] opacity-80"></canvas>

  <!-- Bottom -->
  <div class="w-full flex justify-between items-center text-[11px] font-mono opacity-80 mt-1" style="color:var(--pb-text-sub)">
    <span id="cpu-cores-text">Connecting...</span>
  </div>

  <!-- Error overlay -->
  <div id="cpu-error-overlay" class="hidden absolute inset-0 backdrop-blur-sm flex flex-col items-center justify-center gap-2 p-4 rounded-[24px]" style="background:rgba(13,15,19,0.85)">
    <span class="material-symbols-outlined text-[#ff3b30] text-2xl">error</span>
    <span id="cpu-error-text" class="font-mono text-[9px] text-[#ff3b30] text-center leading-relaxed"></span>
  </div>
</div>

<script>
  const CPU_HISTORY = [];
  const MAX_POINTS = 30;

  function drawSparkline(canvasEl, data, color = '#00d4ff') {
    if (!canvasEl || data.length < 2) return;
    const dpr = window.devicePixelRatio || 1;
    const w = canvasEl.offsetWidth;
    const h = canvasEl.height;
    canvasEl.width = w * dpr;
    canvasEl.height = h * dpr;
    const ctx = canvasEl.getContext('2d');
    ctx.scale(dpr, dpr);
    ctx.clearRect(0, 0, w, h);

    const max = 100, min = 0;
    const range = max - min || 1;
    const pts = data.map((v, i) => ({
      x: (i / (data.length - 1)) * w,
      y: h - ((v - min) / range) * (h - 4) - 2
    }));

    // Filled gradient area
    const grad = ctx.createLinearGradient(0, 0, 0, h);
    grad.addColorStop(0, color + '33');
    grad.addColorStop(1, color + '00');
    ctx.beginPath();
    ctx.moveTo(pts[0].x, h);
    pts.forEach(p => ctx.lineTo(p.x, p.y));
    ctx.lineTo(pts[pts.length-1].x, h);
    ctx.closePath();
    ctx.fillStyle = grad;
    ctx.fill();

    // Stroke line
    ctx.beginPath();
    pts.forEach((p, i) => i === 0 ? ctx.moveTo(p.x, p.y) : ctx.lineTo(p.x, p.y));
    ctx.strokeStyle = color;
    ctx.lineWidth = 1.5;
    ctx.lineJoin = 'round';
    ctx.stroke();
  }

  async function updateCpu() {
    const errorOverlay = document.getElementById('cpu-error-overlay');
    const errorText = document.getElementById('cpu-error-text');
    const percentEl = document.getElementById('cpu-percent-text');
    const barEl = document.getElementById('cpu-progress-bar');
    const coresEl = document.getElementById('cpu-cores-text');
    const canvas = document.getElementById('cpu-sparkline');

    try {
      const backendUrl = localStorage.getItem('pulseboard_backend_url') || 'http://localhost:8000';
      const res = await fetch(`${backendUrl}/api/system-metrics`);
      if (!res.ok) {
        const e = await res.json().catch(() => ({ detail: res.statusText }));
        throw new Error(`HTTP ${res.status}: ${e?.detail?.reason || e?.detail || res.statusText}`);
      }
      const data = await res.json();

      if (errorOverlay) errorOverlay.classList.add('hidden');
      if (percentEl) percentEl.textContent = `${data.cpu}%`;
      if (barEl) barEl.style.width = `${data.cpu}%`;
      if (coresEl) coresEl.textContent = data.cpuText || 'Active';

      // Push to history & redraw sparkline
      CPU_HISTORY.push(data.cpu);
      if (CPU_HISTORY.length > MAX_POINTS) CPU_HISTORY.shift();
      drawSparkline(canvas, CPU_HISTORY, '#00d4ff');

      // Alert threshold check
      const threshold = parseInt(localStorage.getItem('pb_alert_cpu') || '80');
      if (data.cpu >= threshold) window.dispatchEvent(new CustomEvent('pb-alert', { detail: { metric: 'CPU', value: data.cpu, threshold } }));

    } catch (e) {
      if (errorOverlay) errorOverlay.classList.remove('hidden');
      if (errorText) errorText.textContent = e.message;
      if (percentEl) percentEl.textContent = 'ERR';
      if (barEl) barEl.style.width = '0%';
      console.error('[CpuCard]', e.message);
    }
  }

  updateCpu();
  setInterval(updateCpu, 5000);
  window.addEventListener('storage', updateCpu);
  window.addEventListener('refreshMetrics', updateCpu);
</script>
