---
// DiskCard.astro — Real disk metrics + sparkline history chart
---

<div class="ios-glass p-4 rounded-[24px] flex flex-col justify-between aspect-square w-full relative overflow-hidden transition-all active:scale-98">
  <!-- Widget Top -->
  <div class="flex justify-between items-start w-full">
    <div class="w-9 h-9 rounded-full bg-[#34c759]/10 flex items-center justify-center text-[#34c759]">
      <span class="material-symbols-outlined text-lg">dns</span>
    </div>
    <span class="font-mono text-[10px] uppercase font-bold tracking-wider opacity-70" style="color:var(--pb-text-sub)">STORAGE</span>
  </div>

  <!-- Main Metric -->
  <div class="my-2 flex flex-col items-start gap-1">
    <span id="disk-percent-text" class="font-mono text-3xl font-extrabold text-[#34c759] tracking-tight">--%</span>
    <div class="w-full bg-black/20 h-[4px] rounded-full overflow-hidden">
      <div id="disk-progress-bar" class="bg-[#34c759] h-full progress-bar-anim rounded-full" style="width:0%"></div>
    </div>
  </div>

  <!-- Sparkline -->
  <canvas id="disk-sparkline" height="36" class="w-full rounded-[6px] opacity-80"></canvas>

  <!-- Bottom -->
  <div class="w-full flex justify-between items-center text-[11px] font-mono opacity-80 mt-1" style="color:var(--pb-text-sub)">
    <span id="disk-status-text">Connecting...</span>
  </div>

  <!-- Error overlay -->
  <div id="disk-error-overlay" class="hidden absolute inset-0 backdrop-blur-sm flex flex-col items-center justify-center gap-2 p-4 rounded-[24px]" style="background:rgba(13,15,19,0.85)">
    <span class="material-symbols-outlined text-[#ff3b30] text-2xl">error</span>
    <span id="disk-error-text" class="font-mono text-[9px] text-[#ff3b30] text-center leading-relaxed"></span>
  </div>
</div>

<script>
  const DISK_HISTORY = [];
  const MAX_POINTS = 30;

  function drawSparkline(canvasEl, data, color = '#34c759') {
    if (!canvasEl || data.length < 2) return;
    const dpr = window.devicePixelRatio || 1;
    const w = canvasEl.offsetWidth;
    const h = canvasEl.height;
    canvasEl.width = w * dpr;
    canvasEl.height = h * dpr;
    const ctx = canvasEl.getContext('2d');
    ctx.scale(dpr, dpr);
    ctx.clearRect(0, 0, w, h);
    const pts = data.map((v, i) => ({
      x: (i / (data.length - 1)) * w,
      y: h - (v / 100) * (h - 4) - 2
    }));
    const grad = ctx.createLinearGradient(0, 0, 0, h);
    grad.addColorStop(0, color + '33');
    grad.addColorStop(1, color + '00');
    ctx.beginPath();
    ctx.moveTo(pts[0].x, h);
    pts.forEach(p => ctx.lineTo(p.x, p.y));
    ctx.lineTo(pts[pts.length-1].x, h);
    ctx.closePath();
    ctx.fillStyle = grad;
    ctx.fill();
    ctx.beginPath();
    pts.forEach((p, i) => i === 0 ? ctx.moveTo(p.x, p.y) : ctx.lineTo(p.x, p.y));
    ctx.strokeStyle = color;
    ctx.lineWidth = 1.5;
    ctx.lineJoin = 'round';
    ctx.stroke();
  }

  async function updateDisk() {
    const errorOverlay = document.getElementById('disk-error-overlay');
    const errorText = document.getElementById('disk-error-text');
    const percentEl = document.getElementById('disk-percent-text');
    const barEl = document.getElementById('disk-progress-bar');
    const statusEl = document.getElementById('disk-status-text');
    const canvas = document.getElementById('disk-sparkline');

    try {
      const backendUrl = localStorage.getItem('pulseboard_backend_url') || 'http://localhost:8000';
      const res = await fetch(`${backendUrl}/api/system-metrics`);
      if (!res.ok) {
        const e = await res.json().catch(() => ({ detail: res.statusText }));
        throw new Error(`HTTP ${res.status}: ${e?.detail?.reason || e?.detail || res.statusText}`);
      }
      const data = await res.json();

      if (errorOverlay) errorOverlay.classList.add('hidden');

      const isHigh = data.disk >= 90;
      const color = isHigh ? '#ff9500' : '#34c759';
      if (percentEl) { percentEl.textContent = `${data.disk}%`; percentEl.style.color = color; }
      if (barEl) { barEl.style.width = `${data.disk}%`; barEl.style.background = color; }
      if (statusEl) statusEl.textContent = data.diskText || `${data.disk}% used`;

      DISK_HISTORY.push(data.disk);
      if (DISK_HISTORY.length > MAX_POINTS) DISK_HISTORY.shift();
      drawSparkline(canvas, DISK_HISTORY, color);

      const threshold = parseInt(localStorage.getItem('pb_alert_disk') || '90');
      if (data.disk >= threshold) window.dispatchEvent(new CustomEvent('pb-alert', { detail: { metric: 'Disk', value: data.disk, threshold } }));

    } catch (e) {
      if (errorOverlay) errorOverlay.classList.remove('hidden');
      if (errorText) errorText.textContent = e.message;
      if (percentEl) percentEl.textContent = 'ERR';
      if (barEl) barEl.style.width = '0%';
      console.error('[DiskCard]', e.message);
    }
  }

  updateDisk();
  setInterval(updateDisk, 5000);
  window.addEventListener('storage', updateDisk);
  window.addEventListener('refreshMetrics', updateDisk);
</script>
