# ─── PulseBoard Environment Variables ─────────────────────────────────────────
# Copy this file to .env and fill in your values.
# .env is gitignored — this .env.example is safe to commit.

# GitHub Personal Access Token (for Activity Feed)
# Create one at: https://github.com/settings/tokens
# Required scopes: repo (or public_repo for public repos only)
GITHUB_TOKEN=your_github_token_here

# PulseBoard API Key (for backend authentication)
# Leave empty to disable API key authentication (recommended for local dev).
# Set to a strong random string for any internet-facing deployment.
# Example: openssl rand -hex 32
PULSEBOARD_API_KEY=

# SQLite database path (inside the backend container/process)
DB_PATH=./backend/data/settings.db
